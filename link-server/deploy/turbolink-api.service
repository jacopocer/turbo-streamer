[Unit]
Description=Turbolink rendezvous API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/turbolink/api
ExecStart=/usr/bin/env node index.js
Environment=PORT=8814
Environment=HOST=127.0.0.1
Environment=TURBOLINK_DATA=/opt/turbolink/data
Environment=NODE_ENV=production
Environment=RELAY_HOST=turbostreamer.indigital.tv
Environment=RELAY_SRT_PORT=8890
Environment=RELAY_RTMP_PORT=1935
Environment=RELAY_LATENCY_MS=200
# Tailscale API token for minting join keys: set in /opt/turbolink/tailnet.env
# (TS_API_TOKEN=tskey-api-…, TS_TAILNET=-, TS_TAG=tag:turbo), never in this unit.
EnvironmentFile=-/opt/turbolink/tailnet.env
Restart=on-failure
RestartSec=5

ProtectSystem=strict
ReadWritePaths=/opt/turbolink/data
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
